# Django Core Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False

# Database
# DATABASE_URL=sqlite:///db.sqlite3  # For local development

# CORS Settings (for mobile app access)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:8100,http://localhost:3000,capacitor://localhost,http://localhost
CORS_ALLOW_CREDENTIALS=True

# CSRF Settings
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com,http://localhost:8100,capacitor://localhost
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=None

# Allowed Hosts
ALLOWED_HOSTS=your-backend-domain.com,localhost,127.0.0.1

# JWT Settings (if using JWT authentication)
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=3600

# Chapa credentials deprecated in current Telebirr-only flow.
# Keep only if you still use legacy integrations.
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_RETURN_URL=
CHAPA_CALLBACK_URL=

# Telebirr Escrow Credentials
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_MERCHANT_ID=your-telebirr-merchant-id
TELEBIRR_NOTIFY_URL=https://your-api-domain.com/payments/telebirr/notify
